# ==========================================
# OPTION 1: Local Development (Mailpit)
# ==========================================
# This is the default. If you use docker-compose, Mailpit captures all outgoing 
# emails and displays them in a local web interface at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=testing@local.dev
# SMTP_USE_TLS=False

# ==========================================
# OPTION 2: Real Emails (e.g., Gmail)
# ==========================================
# To send actual emails, uncomment the lines below and fill in your details.
# Note: For Gmail, you must use an App Password, NOT your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_USE_TLS=True

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost/
