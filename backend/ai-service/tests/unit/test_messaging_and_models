# ===========================================================================
# AbstractMessage
# ===========================================================================

class _ConcreteMessage(AbstractMessage):
    """Minimal concrete subclass for testing AbstractMessage."""
    text: str


class TestAbstractMessage:
    """Unit tests for AbstractMessage serialisation helpers."""

    def test_to_bytes_produces_valid_json_bytes(self) -> None:
        """to_bytes() should return UTF-8-encoded JSON."""
        msg = _ConcreteMessage(text="hello")
        data = msg.to_bytes()
        assert isinstance(data, bytes)
        parsed = json.loads(data)
        assert parsed["text"] == "hello"

    def test_from_bytes_reconstructs_message(self) -> None:
        """from_bytes() should deserialise back to the original message."""
        msg = _ConcreteMessage(text="world")
        reconstructed = _ConcreteMessage.from_bytes(msg.to_bytes())
        assert reconstructed.text == "world"

    def test_roundtrip_preserves_all_fields(self) -> None:
        """A full serialise→deserialise cycle should preserve every field."""
        msg = _ConcreteMessage(text="roundtrip check")
        assert _ConcreteMessage.from_bytes(msg.to_bytes()) == msg

    def test_str_includes_class_name(self) -> None:
        """__str__ should contain the class name."""
        msg = _ConcreteMessage(text="test")
        assert "_ConcreteMessage" in str(msg)

    def test_str_includes_field_values(self) -> None:
        """__str__ should include the field value."""
        msg = _ConcreteMessage(text="visible value")
        assert "visible value" in str(msg)


