class TestAICompletedMessage:
    """Unit tests for AICompletedMessage."""

    def test_processed_at_auto_set_to_utc_when_none(self) -> None:
        """processed_at should default to the current UTC time."""
        msg = AICompletedMessage(
            filename="audio.wav",
            summary="Summary text.",
            prescription={"medication_name": "Aspirin"},
        )
        assert msg.processed_at is not None
        assert msg.processed_at.tzinfo == timezone.utc

    def test_explicit_processed_at_is_preserved(self) -> None:
        """A provided processed_at should not be overwritten."""
        fixed_time = datetime(2024, 6, 1, 12, 0, 0, tzinfo=timezone.utc)
        msg = AICompletedMessage(
            filename="file.mp3",
            summary="Clinical notes.",
            prescription={},
            processed_at=fixed_time,
        )
        assert msg.processed_at == fixed_time

    def test_serialises_and_deserialises(self) -> None:
        """to_bytes / from_bytes roundtrip should preserve all fields."""
        msg = AICompletedMessage(
            filename="test.wav",
            summary="Patient is fine.",
            prescription={"medication_name": "Ibuprofen", "dosage": "400mg"},
        )
        restored = AICompletedMessage.from_bytes(msg.to_bytes())
        assert restored.filename == msg.filename
        assert restored.summary == msg.summary
        assert restored.prescription == msg.prescription

    def test_prescription_dict_can_contain_nulls(self) -> None:
        """Prescription field should accept a dict with None values."""
        msg = AICompletedMessage(
            filename="x.wav",
            summary="No meds.",
            prescription={"medication_name": None, "notes": "No prescription indicated."},
        )
        assert msg.prescription["medication_name"] is None


