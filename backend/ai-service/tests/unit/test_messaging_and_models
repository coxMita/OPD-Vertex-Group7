class TestPubSubFacade:
    """Unit tests for PubSubFacade."""

    def test_exchange_name_property(self) -> None:
        """exchange_name should return the value passed to __init__."""
        facade = PubSubFacade("amqp://localhost", "my.exchange")
        assert facade.exchange_name == "my.exchange"

    def test_is_connected_false_before_connect(self) -> None:
        """is_connected should be False before connect() is called."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")
        assert facade.is_connected is False

    @pytest.mark.asyncio
    async def test_connect_sets_exchange(self) -> None:
        """After connect(), the internal exchange object should be set."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")

        mock_exchange = MagicMock()
        mock_channel = AsyncMock()
        mock_channel.declare_exchange = AsyncMock(return_value=mock_exchange)
        mock_connection = AsyncMock()
        mock_connection.channel = AsyncMock(return_value=mock_channel)

        with patch("src.messaging.pubsub_facade.aio_pika.connect_robust", new=AsyncMock(return_value=mock_connection)):
            await facade.connect()

        assert facade._exchange is mock_exchange

    @pytest.mark.asyncio
    async def test_publish_raises_if_not_connected(self) -> None:
        """publish() should raise RuntimeError when called before connect()."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")
        msg = AICompletedMessage(
            filename="f.wav", summary="s", prescription={}
        )
        with pytest.raises(RuntimeError, match="connect"):
            await facade.publish(msg)

    @pytest.mark.asyncio
    async def test_publish_sends_message_bytes(self) -> None:
        """publish() should call exchange.publish with the serialised message."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")

        mock_exchange = AsyncMock()
        facade._exchange = mock_exchange

        msg = AICompletedMessage(
            filename="audio.wav",
            summary="Patient is fine.",
            prescription={"medication_name": "Aspirin"},
        )

        with patch("src.messaging.pubsub_facade.aio_pika.Message") as mock_msg_cls:
            mock_amqp_msg = MagicMock()
            mock_msg_cls.return_value = mock_amqp_msg
            await facade.publish(msg)

        mock_exchange.publish.assert_awaited_once_with(mock_amqp_msg, routing_key="")
        # Verify the bytes passed to aio_pika.Message match the serialised payload
        body_arg = mock_msg_cls.call_args.kwargs["body"]
        assert json.loads(body_arg)["filename"] == "audio.wav"

    def test_subscribe_raises_if_not_connected(self) -> None:
        """subscribe() should raise RuntimeError when called before connect()."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")
        with pytest.raises(RuntimeError, match="connect"):
            facade.subscribe("queue", AsyncMock(), None)

    @pytest.mark.asyncio
    async def test_close_cancels_consumer_task(self) -> None:
        """close() should cancel any running consumer task."""
        facade = PubSubFacade("amqp://localhost", "test.exchange")

        mock_task = MagicMock()
        mock_task.cancel = MagicMock()
        mock_task.done = MagicMock(return_value=False)

        import asyncio
        real_task = asyncio.get_event_loop().create_task(asyncio.sleep(100))
        facade._consumer_task = real_task

        # Set up a closed channel/connection so close() doesn't actually reconnect
        mock_channel = MagicMock()
        mock_channel.is_closed = True
        mock_connection = MagicMock()
        mock_connection.is_closed = True
        facade._channel = mock_channel
        facade._connection = mock_connection

        await facade.close()
        assert real_task.cancelled()


