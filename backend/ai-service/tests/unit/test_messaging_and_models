class TestOnTranscriptMessage:
    """Unit tests for on_transcript_message() subscriber callback."""

    @pytest.mark.asyncio
    async def test_happy_path_runs_pipeline_and_publishes(self) -> None:
        """Valid transcript should be processed and AICompletedMessage published."""
        payload = json.dumps({"transcript": "Patient has fever.", "filename": "rec.wav"}).encode()
        fake_result = {
            "summary": "Patient has fever.",
            "prescription": {"medication_name": "Paracetamol"},
        }
        mock_pubsub = AsyncMock()

        with (
            patch("src.messaging.subscriber.process_transcript", new=AsyncMock(return_value=fake_result)),
            patch("src.messaging.subscriber.messaging_manager") as mock_mgr,
        ):
            mock_mgr.get_pubsub.return_value = mock_pubsub
            await on_transcript_message(payload)

        mock_pubsub.publish.assert_awaited_once()
        published: AICompletedMessage = mock_pubsub.publish.call_args.args[0]
        assert published.filename == "rec.wav"
        assert published.summary == fake_result["summary"]

    @pytest.mark.asyncio
    async def test_non_json_body_does_not_raise(self) -> None:
        """Non-JSON bytes should be silently skipped without raising."""
        with patch("src.messaging.subscriber.process_transcript") as mock_pt:
            await on_transcript_message(b"this is not json at all")
        mock_pt.assert_not_called()

    @pytest.mark.asyncio
    async def test_empty_transcript_skips_processing(self) -> None:
        """A message with an empty transcript field should not call process_transcript."""
        payload = json.dumps({"transcript": "", "filename": "empty.wav"}).encode()
        with patch("src.messaging.subscriber.process_transcript") as mock_pt:
            await on_transcript_message(payload)
        mock_pt.assert_not_called()

    @pytest.mark.asyncio
    async def test_missing_transcript_key_skips_processing(self) -> None:
        """A message with no 'transcript' key should not call process_transcript."""
        payload = json.dumps({"filename": "no_transcript.wav"}).encode()
        with patch("src.messaging.subscriber.process_transcript") as mock_pt:
            await on_transcript_message(payload)
        mock_pt.assert_not_called()

    @pytest.mark.asyncio
    async def test_process_transcript_failure_does_not_publish(self) -> None:
        """If process_transcript raises, no message should be published."""
        payload = json.dumps({"transcript": "Some text.", "filename": "f.wav"}).encode()

        with (
            patch(
                "src.messaging.subscriber.process_transcript",
                new=AsyncMock(side_effect=RuntimeError("Ollama down")),
            ),
            patch("src.messaging.subscriber.messaging_manager") as mock_mgr,
        ):
            await on_transcript_message(payload)

        mock_mgr.get_pubsub.assert_not_called()

    @pytest.mark.asyncio
    async def test_publish_failure_does_not_propagate(self) -> None:
        """If publishing raises RuntimeError, the subscriber should not re-raise it."""
        payload = json.dumps({"transcript": "Patient has cough.", "filename": "g.wav"}).encode()
        fake_result = {"summary": "Cough noted.", "prescription": {}}
        mock_pubsub = AsyncMock()
        mock_pubsub.publish.side_effect = RuntimeError("broker unreachable")

        with (
            patch("src.messaging.subscriber.process_transcript", new=AsyncMock(return_value=fake_result)),
            patch("src.messaging.subscriber.messaging_manager") as mock_mgr,
        ):
            mock_mgr.get_pubsub.return_value = mock_pubsub
            # Should not raise
            await on_transcript_message(payload)

    @pytest.mark.asyncio
    async def test_default_filename_when_missing(self) -> None:
        """Missing 'filename' key should fall back to 'unknown'."""
        payload = json.dumps({"transcript": "Doctor prescribed rest."}).encode()
        fake_result = {"summary": "Rest prescribed.", "prescription": {}}
        mock_pubsub = AsyncMock()

        with (
            patch("src.messaging.subscriber.process_transcript", new=AsyncMock(return_value=fake_result)),
            patch("src.messaging.subscriber.messaging_manager") as mock_mgr,
        ):
            mock_mgr.get_pubsub.return_value = mock_pubsub
            await on_transcript_message(payload)

        published: AICompletedMessage = mock_pubsub.publish.call_args.args[0]
        assert published.filename == "unknown"