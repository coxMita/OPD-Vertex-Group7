AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# ── LLM (OpenAI-compatible API) ───────────────────────────────────────────────
# UCloud vLLM job (public link of the LLM nginx job, ending in /v1):
LLM_BASE_URL=https://app-opd-llm.cloud.sdu.dk/v1
LLM_API_KEY=<contents of /work/opd-llm/secrets/api_token>
LLM_MODEL=opd-llm
EMBED_MODEL=opd-embed
# Local fallback instead (docker compose --profile local-llm up):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=300
LLM_DISABLE_THINKING=true

# pgvector database for RAG transcript store
AI_DB_URL=postgresql://ai_user:ai_pass@ai-db:5432/ai_db
