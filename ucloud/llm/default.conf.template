# nginx config for the OPD-Vertex LLM job on UCloud.
# init.sh replaces __API_TOKEN__ with the token in secrets/api_token and
# installs the result as /etc/nginx/conf.d/default.conf.
# NEVER commit a real token into this file.

server {
    listen 8080;            # the UCloud public link points at this port
    http2 on;
    server_name localhost;

    # Simple shared-secret auth: every request needs "Authorization: Bearer <token>"
    if ($http_authorization != "Bearer __API_TOKEN__") {
        return 401;
    }

    proxy_read_timeout    600s;   # long generations
    proxy_send_timeout    600s;
    proxy_connect_timeout 30s;
    client_max_body_size  50m;

    proxy_buffering off;          # allows streaming responses
    proxy_cache     off;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection        "";

    # Embeddings go to the second vLLM process
    location /v1/embeddings {
        proxy_pass http://127.0.0.1:8001;
    }

    # Everything else (chat/completions, /v1/models, /health) -> chat model
    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
