# nginx config for the OPD-Vertex faster-whisper job on UCloud.
# init.sh replaces __API_TOKEN__ with the token in secrets/api_token and
# installs the result as /etc/nginx/conf.d/default.conf.
# NEVER commit a real token into this file.

server {
    listen 8080;            # the UCloud public link points at this port
    http2 on;
    server_name localhost;

    if ($http_authorization != "Bearer __API_TOKEN__") {
        return 401;
    }

    proxy_read_timeout    900s;   # long consultations take a while to transcribe
    proxy_send_timeout    900s;
    proxy_connect_timeout 30s;
    client_max_body_size  500m;   # audio uploads

    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection        "";
    }
}
