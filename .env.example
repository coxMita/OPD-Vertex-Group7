# ── Databases ─────────────────────────────────────────────────────────────────
APPOINTMENT_DB_USER=appointment_user
APPOINTMENT_DB_PASS=appointment_pass
APPOINTMENT_DB_NAME=appointment_db

CONSULTATION_DB_USER=consultation_user
CONSULTATION_DB_PASS=consultation_pass
CONSULTATION_DB_NAME=consultation_db

PRESCRIPTION_DB_USER=prescription_user
PRESCRIPTION_DB_PASS=prescription_pass
PRESCRIPTION_DB_NAME=prescription_db

USER_DB_USER=user_user
USER_DB_PASS=user_pass
USER_DB_NAME=user_db

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123

# pgvector database for ai-service RAG store
AI_DB_USER=ai_user
AI_DB_PASS=ai_pass
AI_DB_NAME=ai_db

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI / ML ───────────────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# Path to local GGUF model file for LLM inference
LLM_MODEL_PATH=/models/llama

# ── HuggingFace ─────────────────────────────────────────────────────────────
HF_TOKEN=

# -- Keycloak ----------------------------------------------------------------

KC_ADMIN_USERNAME=admin

KC_ADMIN_PASSWORD=admin123

KC_DB_TYPE=postgres

KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak_db

KC_DB_USER=keycloak_user

KC_DB_PASS=keycloak_pass

KC_DB_NAME=keycloak_db

# ── AI / ML on UCloud (see ucloud/README.md) ──────────────────────────────────
# LLM + embeddings: public link of the LLM nginx job, ending in /v1
LLM_BASE_URL=https://app-opd-llm.cloud.sdu.dk/v1
# Token printed by the LLM job / stored in /work/opd-llm/secrets/api_token
LLM_API_KEY=
LLM_MODEL=opd-llm
EMBED_MODEL=opd-embed
LLM_TIMEOUT=300
# Offline alternative: `docker compose --profile local-llm up` with
#   LLM_BASE_URL=http://ollama:11434/v1  LLM_API_KEY=
#   LLM_MODEL=llama3.2:3b               EMBED_MODEL=nomic-embed-text

# Transcription: public link of the Whisper nginx job, ending in /v1
# (leave empty to run faster-whisper locally on CPU)
WHISPER_API_URL=https://app-opd-whisper.cloud.sdu.dk/v1
# Token stored in /work/opd-whisper/secrets/api_token
WHISPER_API_KEY=
# Only used for the local CPU fallback: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_DEFAULT_THEME=light